<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>OpenSpeaker</AssemblyName>
    <RootNamespace>OpenSpeaker</RootNamespace>
    <Product>OpenSpeaker</Product>
    <AssemblyTitle>OpenSpeaker</AssemblyTitle>
    <Company>Evaisa</Company>
    <Authors>Evaisa</Authors>
    <Description>Text-to-speech bot for streamers.</Description>
    <Copyright>Copyright © 2026 Evaisa</Copyright>
    <ApplicationIcon>OpenSpeaker.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Fleck" Version="1.2.0" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.40.0" />
    <PackageReference Include="AWSSDK.Polly" Version="3.7.400" />
    <PackageReference Include="Google.Cloud.TextToSpeech.V1" Version="3.8.0" />
    <PackageReference Include="System.Net.Http.WinHttpHandler" Version="10.0.9" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="TwitchLib.Api" Version="3.10.1" />
    <PackageReference Include="TwitchLib.EventSub.Websockets" Version="0.8.0" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="LuaCSharp" Version="0.5.5" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.0" />
  </ItemGroup>

  <ItemGroup>
    <UserAssetTemplate Include="$(MSBuildProjectDirectory)\Themes\README.txt">
      <Dest>Themes\README.txt</Dest>
    </UserAssetTemplate>
    <UserAssetTemplate Include="$(MSBuildProjectDirectory)\Localization\en.xaml">
      <Dest>Localization\English.xaml</Dest>
    </UserAssetTemplate>
    <UserAssetTemplate Include="$(MSBuildProjectDirectory)\Localization\README.txt">
      <Dest>Localization\README.txt</Dest>
    </UserAssetTemplate>
  </ItemGroup>

  <UsingTask TaskName="EmitLooseTheme" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = System.IO.File.ReadAllText(Source);
        text = text.Replace("clr-namespace:OpenSpeaker.Converters\"", "clr-namespace:OpenSpeaker.Converters;assembly=OpenSpeaker\"");
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(Destination));
        System.IO.File.WriteAllText(Destination, text);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="CopyUserAssetTemplates" AfterTargets="Build">
    <Copy SourceFiles="@(UserAssetTemplate)" DestinationFiles="@(UserAssetTemplate->'$(OutputPath)%(Dest)')" SkipUnchangedFiles="true" />
    <EmitLooseTheme Source="$(MSBuildProjectDirectory)\Themes\DarkTheme.xaml" Destination="$(OutputPath)Themes\Dark.xaml" />
    <EmitLooseTheme Source="$(MSBuildProjectDirectory)\Themes\LightTheme.xaml" Destination="$(OutputPath)Themes\Light.xaml" />
  </Target>

  <Target Name="CopyUserAssetTemplatesOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(UserAssetTemplate)" DestinationFiles="@(UserAssetTemplate->'$(PublishDir)%(Dest)')" SkipUnchangedFiles="true" />
    <EmitLooseTheme Source="$(MSBuildProjectDirectory)\Themes\DarkTheme.xaml" Destination="$(PublishDir)Themes\Dark.xaml" />
    <EmitLooseTheme Source="$(MSBuildProjectDirectory)\Themes\LightTheme.xaml" Destination="$(PublishDir)Themes\Light.xaml" />
  </Target>

  <Target Name="CopyMoveAfterFiles" AfterTargets="Build">
    <ItemGroup>
      <MoveAfterFiles Include="$(MSBuildProjectDirectory)\Content\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(MoveAfterFiles)" DestinationFiles="@(MoveAfterFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyMoveAfterFilesOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <MoveAfterFiles Include="$(MSBuildProjectDirectory)\Content\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(MoveAfterFiles)" DestinationFiles="@(MoveAfterFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <LuaShimSourceDir>$(MSBuildProjectDirectory)\Native\LuaShim\</LuaShimSourceDir>
    <LuaShimIncludeDir>$(MSBuildProjectDirectory)\Content\docs\native\include\</LuaShimIncludeDir>
  </PropertyGroup>

  <ItemGroup>
    <LuaShimInputs Include="$(LuaShimSourceDir)*.c;$(LuaShimSourceDir)*.h;$(LuaShimIncludeDir)*.h" />
  </ItemGroup>

  <Target Name="FindMsvcForLuaShim" BeforeTargets="BuildLuaShim">
    <PropertyGroup>
      <VsWherePath>$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe</VsWherePath>
      <LuaShimOutDir>$([MSBuild]::EnsureTrailingSlash('$([System.IO.Path]::GetFullPath('$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'luashim'))'))'))</LuaShimOutDir>
    </PropertyGroup>
    <Exec Condition="Exists('$(VsWherePath)')" Command="&quot;$(VsWherePath)&quot; -latest -prerelease -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="LuaShimVsPath" />
    </Exec>
    <PropertyGroup>
      <LuaShimVcVars>$(LuaShimVsPath)\VC\Auxiliary\Build\vcvars64.bat</LuaShimVcVars>
      <LuaShimCanBuild Condition="'$(LuaShimVsPath)' != '' And Exists('$(LuaShimVcVars)')">true</LuaShimCanBuild>
    </PropertyGroup>
    <Warning Condition="'$(LuaShimCanBuild)' != 'true'" Text="MSVC (Desktop development with C++) was not found, so lua54.dll was not built. Lua extensions will not be able to load native modules." />
  </Target>

  <Target Name="BuildLuaShim" AfterTargets="Build" DependsOnTargets="FindMsvcForLuaShim" Inputs="@(LuaShimInputs)" Outputs="$(LuaShimOutDir)lua54.dll" Condition="'$(OS)' == 'Windows_NT'">
    <MakeDir Directories="$(LuaShimOutDir)" />
    <Exec Condition="'$(LuaShimCanBuild)' == 'true'" WorkingDirectory="$(LuaShimOutDir)" Command="call &quot;$(LuaShimVcVars)&quot; &gt;nul &amp;&amp; cl /nologo /LD /O2 /W4 /wd4324 /D_CRT_SECURE_NO_WARNINGS /std:c11 /DLUA_BUILD_AS_DLL /DLUA_CORE /I&quot;$(LuaShimIncludeDir.TrimEnd('\'))&quot; &quot;$(LuaShimSourceDir)osn_core.c&quot; &quot;$(LuaShimSourceDir)osn_aux.c&quot; /Fe:lua54.dll /link /IMPLIB:lua54.lib" />
  </Target>

  <Target Name="CopyLuaShim" AfterTargets="BuildLuaShim" DependsOnTargets="FindMsvcForLuaShim">
    <Copy Condition="Exists('$(LuaShimOutDir)lua54.dll')" SourceFiles="$(LuaShimOutDir)lua54.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy Condition="Exists('$(LuaShimOutDir)lua54.lib')" SourceFiles="$(LuaShimOutDir)lua54.lib" DestinationFolder="$(OutDir)docs\native\lib" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyLuaShimOnPublish" AfterTargets="Publish" DependsOnTargets="FindMsvcForLuaShim">
    <Copy Condition="Exists('$(LuaShimOutDir)lua54.dll')" SourceFiles="$(LuaShimOutDir)lua54.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy Condition="Exists('$(LuaShimOutDir)lua54.lib')" SourceFiles="$(LuaShimOutDir)lua54.lib" DestinationFolder="$(PublishDir)docs\native\lib" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyNativeDllsOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <AzureNativeDlls Include="$(NuGetPackageRoot)microsoft.cognitiveservices.speech\1.40.0\runtimes\win-x64\native\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(AzureNativeDlls)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
