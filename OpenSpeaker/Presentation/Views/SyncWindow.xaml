<Window x:Class="OpenSpeaker.Views.SyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Sync.Title}" Width="560" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg1}" Foreground="{DynamicResource TextPrimary}">
    <DockPanel Margin="16">

        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Sync.Description}"
                   Style="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="{DynamicResource Btn.Refresh}" Command="{Binding RefreshCommand}"
                        Padding="14,6" Margin="0,0,8,0"
                        ToolTip="{DynamicResource Tip.SyncRefresh}"/>
                <Button Content="{DynamicResource Btn.Cancel}" Command="{Binding CancelCommand}"
                        Padding="14,6" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource Btn.SyncNow}" Command="{Binding SyncCommand}"
                        Style="{DynamicResource AccentButton}" Padding="14,6"
                        ToolTip="{DynamicResource Tip.SyncNow}"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" Style="{DynamicResource MutedText}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <DockPanel Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="{DynamicResource Btn.SelectAll}" Command="{Binding SelectAllCommand}"
                            Style="{DynamicResource GhostButton}" Padding="8,2" Margin="0,0,4,0"/>
                    <Button Content="{DynamicResource Btn.SelectNone}" Command="{Binding SelectNoneCommand}"
                            Style="{DynamicResource GhostButton}" Padding="8,2"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource Sync.WhatToSync}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <Border BorderBrush="{DynamicResource BorderBrush0}" BorderThickness="1" Background="{DynamicResource Bg2}" Padding="8,6">
                <ItemsControl ItemsSource="{Binding Categories}" IsEnabled="{Binding IsIdle}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="2,3"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <Border BorderBrush="{DynamicResource BorderBrush0}" BorderThickness="1">
            <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                     IsEnabled="{Binding IsIdle}" Background="{DynamicResource Bg2}"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding InstanceName}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding InstanceId}" Style="{DynamicResource MutedText}"
                                           FontFamily="Consolas" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Endpoint}" Style="{DynamicResource MutedText}"
                                           FontSize="11" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Version}" Style="{DynamicResource MutedText}"
                                           FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

    </DockPanel>
</Window>
