<Window x:Class="OpenSpeaker.Views.TwitchAuthWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Twitch Login" Height="340" Width="440"
		ResizeMode="NoResize"
		WindowStartupLocation="CenterOwner"
		Background="{StaticResource Bg1}"
		Foreground="{StaticResource TextPrimary}">
	<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
		<TextBlock x:Name="HeaderText" Text="A browser window will open to log in with Twitch." FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" Margin="0,0,0,6"/>
		<TextBlock x:Name="HintText" Text="If you're asked for a code, enter the one shown below." Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" Margin="0,0,0,16"/>
		<TextBlock x:Name="CodeText" FontSize="28" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,0,0,16" Visibility="Collapsed"/>
		<TextBlock x:Name="StatusText" Text="Requesting a login code from Twitch..." Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" Margin="0,0,0,20"/>
		<Button x:Name="CopyLinkButton" Content="Copy login link" HorizontalAlignment="Center" Padding="20,7" Margin="0,0,0,10" Visibility="Collapsed" Click="CopyLink_Click"/>
		<Button Content="Cancel" HorizontalAlignment="Center" Padding="20,7" Click="Cancel_Click"/>
	</StackPanel>
</Window>
